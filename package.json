{
  "name": "bd-vs-russia-population-video",
  "version": "1.0.0",
  "description": "Cinema-grade 2-minute animated documentary comparing Bangladesh vs Russia population by land size, rendered 100% on GitHub Actions.",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts BangladeshVsRussia out/raw_remotion.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --concurrency=4",
    "stills": "remotion still src/index.ts BangladeshVsRussia out/poster.png --frame=240"
  },
  "dependencies": {
    "@remotion/captions": "4.0.544",
    "@remotion/cli": "4.0.544",
    "@remotion/effects": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "@remotion/media": "4.0.544",
    "@remotion/shapes": "4.0.544",
    "@remotion/transitions": "4.0.544",
    "d3-geo": "3.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.544",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/topojson-client": "^3.1.4",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "5.7.3"
  }
}
